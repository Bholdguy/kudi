# Optional overrides. Defaults live in lib/config.ts.
NEXT_PUBLIC_RPC_URL=
# Second RPC for the fallback transport. Leave empty to run on the primary alone.
NEXT_PUBLIC_RPC_URL_FALLBACK=
# Passkey relying party ID. Must equal the hostname the app is served from.
# Leave empty in dev (defaults to localhost). Set to the production hostname on Vercel.
NEXT_PUBLIC_PASSKEY_RP_ID=
